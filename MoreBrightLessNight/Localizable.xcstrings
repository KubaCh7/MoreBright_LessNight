    "Choose 1000 nit or 1600 nit first, so there is a boost to measure.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw wybierz 1000 nit lub 1600 nit, żeby było co zmierzyć."
          }
        }
      }
    },
    "Choose 1000 nit or 1600 nit, keep this window on that display and click Measure. The boost is turned off briefly for the “before” capture.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz 1000 nit lub 1600 nit, zostaw to okno na tym ekranie i kliknij Zmierz. Podbicie zostanie na chwilę wyłączone na potrzeby zrzutu „przed”."
          }
        }
      }
    },

    "Paused: display asleep or locked": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wstrzymane: ekran uśpiony lub zablokowany"
          }
        }
      }
    },
    "Paused: low battery": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wstrzymane: niski poziom baterii"
          }
        }
      }
    },
    "Paused: on battery power": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wstrzymane: zasilanie z baterii"
          }
        }
      }
    },
    "Paused: thermal limit": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wstrzymane: limit termiczny"
          }
        }
      }
    },
    "Peak (nits)": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szczytowa (nity)"
          }
        }
      }
    },
    "Peak brightness makes the display and your Mac noticeably warmer, drains the battery faster and may accelerate panel ageing. macOS can lower the brightness on its own at any time to protect the display. Highlights may clip if the panel cannot sustain the requested level.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jasność szczytowa wyraźnie nagrzewa ekran i Maca, szybciej rozładowuje baterię i może przyspieszyć zużycie panelu. macOS może w każdej chwili samodzielnie obniżyć jasność, żeby chronić ekran. Jasne tony mogą się przycinać, jeśli panel nie utrzyma żądanego poziomu."
          }
        }
      }
    },
    "Peak was lowered automatically because your Mac got warm": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryb szczytowy obniżono automatycznie, bo Mac się nagrzał"
          }
        }
      }
    },
    "Potential EDR headroom": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Potencjalny zapas EDR"
          }
        }
      }
    },
    "Power adapter": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zasilacz"
          }
        }

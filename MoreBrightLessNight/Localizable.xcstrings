    "Restore Defaults": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przywróć domyślne"
          }
        }
      }
    },
    "Safety": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezpieczeństwo"
          }
        }
      }
    },
    "ScreenCaptureKit did not return this display. Check Screen Recording permission in System Settings.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "ScreenCaptureKit nie zwrócił tego ekranu. Sprawdź uprawnienie Nagrywanie ekranu w Ustawieniach systemowych."
          }
        }
      }
    },
    "Serious": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poważny"
          }
        }
      }
    },
    "Set the slider above the system maximum, keep this window on that display and click Measure. The boost is turned off briefly for the “before” capture.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustaw suwak powyżej systemowego maksimum, zostaw to okno na tym ekranie i kliknij Zmierz. Podbicie zostanie na chwilę wyłączone na potrzeby zrzutu „przed”."
          }
        }
      }
    },
    "Settings…": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustawienia…"
          }
        }
      }
    },
    "Shows reference patches and measures the color difference with and without the boost.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazuje próbki referencyjne i mierzy różnicę kolorów z podbiciem i bez."
          }
        }
      }
    },
    "Status": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Status"
          }
        }
      }
    },
    "Sustained (nits)": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utrzymywalna (nity)"
          }
        }
      }
    },
    "System brightness": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jasność systemowa"
          }
        }
      }
    },
    "System maximum (nits)": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maksimum systemowe (nity)"
          }
        }
      }
    },
    "The brightness keys keep working normally and the slider follows them.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klawisze jasności działają normalnie, a suwak za nimi podąża."
          }
        }
      }
    },
    "The capture did not include the boost (ScreenCaptureKit returned SDR values). The ΔE result below is not meaningful on this macOS version.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zrzut nie zawierał podbicia (ScreenCaptureKit zwrócił wartości SDR). Poniższy wynik ΔE nie ma sensu w tej wersji macOS."
          }
        }
      }
    },
    "The capture returned no image.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zrzut nie zwrócił obrazu."
          }
        }
      }
    },
    "The disk image doesn't contain the app.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obraz dysku nie zawiera aplikacji."
          }
        }
      }
    },
    "The download is damaged (checksum mismatch).": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pobrany plik jest uszkodzony (niezgodna suma kontrolna)."
          }
        }
      }
    },
    "The downloaded app is not MoreBrightLessNight.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pobrana aplikacja to nie MoreBrightLessNight."
          }
        }
      }
    },
    "The downloaded app's code signature is invalid.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podpis kodu pobranej aplikacji jest nieprawidłowy."
          }
        }
      }
    },
    "The extra brightness turns off automatically when the thermal state is serious, when the battery is under 20 percent and while the display sleeps.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodatkowa jasność wyłącza się automatycznie przy poważnym stanie termicznym, gdy bateria spadnie poniżej 20 procent i gdy ekran jest uśpiony."
          }
        }
      }
    },
    "The release has no checksum file, so the update can't be verified.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wydanie nie ma pliku sumy kontrolnej, więc aktualizacji nie da się zweryfikować."
          }
        }
      }
    },
    "Thermal state": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stan termiczny"
          }
        }
      }
    },
    "Thermally limited": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ograniczone termicznie"
          }
        }
      }
    },
    "This display has no EDR headroom, so brightness can't go above the system maximum.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten ekran nie ma zapasu EDR, więc jasność nie przekroczy systemowego maksimum."
          }
        }
      }
    },
    "Toggle full brightness": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przełącz pełną jasność"
          }
        }
      }
    },
    "Turn On": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz"
          }
        }
      }
    },
    "Turn on 1600-nit mode?": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włączyć tryb 1600 nitów?"
          }
        }
      }
    },
    "Turned off automatically because your Mac got warm": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyłączony automatycznie, bo Mac się nagrzał"
          }
        }

    },
    "MoreBrightLessNight can't replace itself in its current folder. Move it to the Applications folder.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "MoreBrightLessNight nie może się podmienić w obecnym folderze. Przenieś ją do folderu Aplikacje."
          }
        }
      }
    },
    "MoreBrightLessNight is up to date.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "MoreBrightLessNight jest aktualna."
          }
        }
      }
    },
    "Move MoreBrightLessNight to the Applications folder to install updates.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przenieś MoreBrightLessNight do folderu Aplikacje, żeby instalować aktualizacje."
          }
        }
      }
    },
    "Move the slider above the system maximum first, so there is a boost to measure.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw przesuń suwak powyżej systemowego maksimum, żeby było co zmierzyć."
          }
        }
      }
    },
    "No displays found": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie znaleziono ekranów"
          }
        }
      }
    },
    "Nominal": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Normalny"
          }
        }
      }
    },
    "Not available": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niedostępne"
          }
        }
      }
    },
    "Off": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyłączony"
          }
        }
      }
    },
    "Off: the full slider equals the brightness the panel can sustain (about 1000 nits on MacBook Pro). On: the full slider equals peak brightness (about 1600 nits). Peak mode turns itself off when your Mac gets warm.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyłączony: pełny suwak to jasność, którą panel utrzyma (ok. 1000 nitów w MacBooku Pro). Włączony: pełny suwak to jasność szczytowa (ok. 1600 nitów). Tryb szczytowy wyłącza się sam, gdy Mac się nagrzeje."
          }
        }
      }
    },
    "Only when connected to power": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko po podłączeniu do zasilania"
          }
        }
      }
    },
    "Open Color Test…": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz test kolorów…"
          }
        }
      }
    },
    "Open the test window on an EDR display first.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw umieść okno testu na ekranie z EDR."
          }
        }
      }
    },
    "Patch": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Próbka"
          }
        }
      }
    },
    "Paused: display asleep": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wstrzymane: ekran uśpiony"
          }
        }
      }
    },
    "Paused: low battery": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wstrzymane: niski poziom baterii"
          }
        }
      }
    },
    "Paused: on battery power": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wstrzymane: zasilanie z baterii"
          }
        }
      }
    },
    "Paused: thermal limit": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wstrzymane: limit termiczny"
          }
        }
      }
    },
    "Peak (nits)": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szczytowa (nity)"
          }
        }
      }
    },
    "Peak Brightness": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jasność szczytowa"
          }
        }
      }
    },
    "Peak brightness makes the display and your Mac noticeably warmer, drains the battery faster and may accelerate panel ageing. macOS can lower the brightness on its own at any time to protect the display. Highlights may clip if the panel cannot sustain the requested level.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jasność szczytowa wyraźnie nagrzewa ekran i Maca, szybciej rozładowuje baterię i może przyspieszyć zużycie panelu. macOS może w każdej chwili samodzielnie obniżyć jasność, żeby chronić ekran. Jasne tony mogą się przycinać, jeśli panel nie utrzyma żądanego poziomu."
          }
        }
      }
    },
    "Potential EDR headroom": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Potencjalny zapas EDR"
          }
        }
      }
    },
    "Power adapter": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zasilacz"
          }
        }
      }
    },
    "Power source": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Źródło zasilania"
          }
        }
      }
    },
    "Quit": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakończ"
          }
        }
      }
    },
    "Red": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czerwony"
          }
        }
      }
    },
    "Reference Patches": {
      "localizations": {

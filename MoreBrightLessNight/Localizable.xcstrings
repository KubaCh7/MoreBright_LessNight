    "Updates": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualizacje"
          }
        }
      }
    },
    "Used to place the slider's knee and cap the boost. The real output is always limited by the headroom macOS reports.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Służy do wyznaczenia punktu przejścia na suwaku i limitu podbicia. Realna jasność zawsze jest ograniczona zapasem zgłaszanym przez macOS."
          }
        }
      }
    },
    "Version %@ is available": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostępna jest wersja %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Brightness for %@"
          }
        }
      }
    },
    "White": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Biały"
          }
        }
      }
    },
    "Yellow": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żółty"
          }
        }
      }
    },
    "Your Mac is warm. Peak mode can be turned on again once the thermal state returns to normal.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac jest nagrzany. Tryb szczytowy można włączyć ponownie, gdy stan termiczny wróci do normy."
          }
        }
      }
    },
    "clipped": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "przycięte"
          }
        }
      }
    },
    "ΔE00": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "ΔE00"
          }
        }
      }
    },
    "ΔE00 is computed after normalising luminance, so it measures only hue and chroma shift. Below 1 is invisible, below 2 is hard to notice.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "ΔE00 liczone po wyrównaniu luminancji, więc mierzy tylko przesunięcie odcienia i nasycenia. Poniżej 1 niewidoczne, poniżej 2 trudno zauważalne."
          }
        }
      }
    }
  },
  "version": "1.0"
}
